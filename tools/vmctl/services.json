{
  "_about": "The one registry of chromium-vm's services (Marko, 14.11.2026: 'we now call the program services'). Installed as /etc/chromium-vm/services.json by tools/vmctl/install.sh. core = on at boot, locked in the gear; every other service is off at boot and started by hand (gear, vmctl) or by a program (vmctl API, leases). short = at most 8 characters, the same name on the status bar, the gear and the API. kind: systemd (system units), user (systemd --user units of ubuntu), docker (a container; start/stop by its commands). deps are started first; a dependency nobody needs any more is stopped again unless it was started by hand. bar: false = a core service the status bar names only when it is down. gui_start: what the gear runs instead of start (e.g. a phone with its mirror on the VM screen).",
  "services": [
    {"name": "ckbond", "short": "CKBOND", "title": "Connection Keeper relay (:443, VPN exit Frankfurt)", "kind": "systemd", "units": ["ckbond.service"], "core": true},
    {"name": "tailscale", "short": "TSCALE", "title": "Tailscale (the way in)", "kind": "systemd", "units": ["tailscaled.service"], "core": true},
    {"name": "ssh", "bar": false, "short": "SSH", "title": "SSH", "kind": "systemd", "units": ["ssh.socket"], "core": true},
    {"name": "xvnc", "bar": false, "short": "XVNC", "title": "VNC screen :1 (Mantra Remote Viewing logs in here)", "kind": "systemd", "units": ["chromium-vm-xvnc.service"], "core": true},
    {"name": "desktop", "bar": false, "short": "DESKTOP", "title": "Desktop (openbox, compositor; no apps)", "kind": "systemd", "units": ["chromium-vm-session.service"], "core": true},
    {"name": "statusbar", "bar": false, "short": "STATUS", "title": "Status bar (bottom line, running services)", "kind": "systemd", "units": ["chromium-vm-statusbar.service"], "core": true},
    {"name": "agent", "bar": false, "short": "AGENT", "title": "vm-agent :8890 (viewer clipboard, paste, screen size)", "kind": "systemd", "units": ["chromium-vm-agent.service"], "core": true},
    {"name": "vmctl", "bar": false, "short": "VMCTL", "title": "vmctl API :8896 (this control)", "kind": "systemd", "units": ["chromium-vm-vmctl.service"], "core": true},
    {"name": "queen", "short": "QUEEN", "title": "Queen (Groq AI Studio, 127.0.0.1:8765)", "kind": "user", "units": ["queen.service"], "core": true},
    {"name": "oracle", "bar": false, "short": "ORACLE", "title": "Oracle Cloud Agent (OCI console, run command)", "kind": "systemd", "units": ["snap.oracle-cloud-agent.oracle-cloud-agent.service"], "core": true},
    {"name": "oraclemon", "bar": false, "short": "ORAMON", "title": "Oracle Unified Monitoring (fluentd); proposed: off", "kind": "systemd", "units": ["unified-monitoring-agent.service"], "core": true},

    {"name": "claude-app", "short": "CLAUDE", "title": "Claude app (Claude Desktop)", "kind": "systemd", "units": ["chromium-vm-claude-app.service"]},
    {"name": "claude-code", "short": "CCODE", "title": "Claude Code (terminal, tmux claude)", "kind": "systemd", "units": ["chromium-vm-claude-code.service"]},
    {"name": "chrome", "short": "CHROME", "title": "Chrome (profiles Work, Marko, tribal.jam.collective)", "kind": "systemd", "units": ["chromium-vm-chrome.service"]},
    {"name": "firefox", "short": "FIREFOX", "title": "Firefox = WhatsApp Web (+ WhatsApp door :8879)", "kind": "user", "units": ["vm-firefox.service", "wa-door.service"],
     "probe": "pgrep -f 'firefox.*--profile /home/ubuntu/.config/vm-firefox'"},
    {"name": "brave", "short": "BRAVE", "title": "Brave (YouTube browser)", "kind": "user", "units": ["vm-brave.service"],
     "probe": "pgrep -f 'brave.*--user-data-dir=/home/ubuntu/.config/vm-brave'"},
    {"name": "pixel1", "short": "PIXEL1", "title": "Pixel 1 (container pixel7, adb :5555, signed in)", "kind": "docker", "containers": ["pixel7"], "deps": ["docker", "idle-reaper"],
     "start": "/usr/local/lib/chromium-vm/chromium-vm-phone ensure 1", "gui_start": "/usr/local/lib/chromium-vm/chromium-vm-phone start 1 --mirror",
     "stop": "/usr/local/lib/chromium-vm/chromium-vm-phone stop 1 vmctl"},
    {"name": "pixel2", "short": "PIXEL2", "title": "Pixel 2 (container pixel7b, adb :5556, WhatsApp Business)", "kind": "docker", "containers": ["pixel7b"], "deps": ["docker", "idle-reaper"],
     "start": "/usr/local/lib/chromium-vm/chromium-vm-phone ensure 2", "gui_start": "/usr/local/lib/chromium-vm/chromium-vm-phone start 2 --mirror",
     "stop": "/usr/local/lib/chromium-vm/chromium-vm-phone stop 2 vmctl"},
    {"name": "pixel-door", "short": "PIXDOOR", "title": "Pixel test door pixel7d :8897 + cloud job runner", "kind": "systemd", "units": ["pixel7d.service", "pixel7-jobs.service"], "deps": ["docker"]},
    {"name": "docker", "short": "DOCKER", "title": "Docker + containerd (only for the Pixels)", "kind": "systemd", "units": ["containerd.service", "docker.socket", "docker.service"]},
    {"name": "idle-reaper", "short": "IDLEREAP", "title": "Idle reaper (stops idle Pixels, every 2 min)", "kind": "systemd", "units": ["chromium-vm-reaper.timer"]},
    {"name": "macro", "short": "MACRO", "title": "Macro Recorder (Mantra) for Linux", "kind": "user", "units": ["mantra-macro.service"]},
    {"name": "dock", "short": "DOCK", "title": "Dock (bottom launcher, Super+Tab) + window refit", "kind": "systemd", "units": ["chromium-vm-dock.service", "chromium-vm-refit.service"]},
    {"name": "gemini", "short": "GEMINI", "title": "Gemini image worker (batch on Drive)", "kind": "systemd", "units": ["chromium-vm-worker-gemini.service"], "deps": ["chrome"]},
    {"name": "ytmon", "short": "YTMON", "title": "YouTube transcriber monitor", "kind": "user", "units": ["yt-monitor.service"]},
    {"name": "ytupload", "short": "YTUPLOAD", "title": "Transcripts to Drive (timer, 30 min)", "kind": "user", "units": ["yt-upload.timer"]},
    {"name": "yttrans", "short": "YTTRANS", "title": "YouTube channel transcriber (Liam Ottley)", "kind": "user", "units": ["yt-transcribe.service"]},
    {"name": "sync", "short": "SYNC", "title": "Two locations sync (Queen skills, macros, manifest; 5 min)", "kind": "user", "units": ["two-locations-sync.timer"]},
    {"name": "sonobus-server", "short": "AOOSERV", "title": "SonoBus connection server aooserver :10998", "kind": "systemd", "units": ["chromium-vm-aooserver.service"]},
    {"name": "reaper-daw", "short": "REAPERDW", "title": "REAPER (DAW) evaluation notice clicker", "kind": "systemd", "units": ["chromium-vm-reaper-evaluating.service"]}
  ]
}
