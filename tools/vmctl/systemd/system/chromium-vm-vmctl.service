[Unit]
Description=chromium-vm: vmctl, the services API (start/stop/lease) on the Tailscale address :8896 (core)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=@VM_USER@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/lib/chromium-vm/vmctl serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
