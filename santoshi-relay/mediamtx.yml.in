# santoshi-relay: MediaMTX on chromium-vm (Marko, 14.11.2026: "I just want to send one stream, and then it is relayed somewhere").
# Installed by santoshi-relay/install.sh as /etc/mediamtx/mediamtx.yml (root:mediamtx 640). @PUBLISH_HASH@ = sha256 of the publish
# key (the key itself is a Cloudflare Pages secret of santoshi-band, RELAY_KEY, given only to a paired camera by /api/live).
#   phone (WHIP, or SRT) --one stream--> santoshi path --> viewers (WHEP ~1 s, LL-HLS fallback) + recording on disk (fmp4, 1 min)
# Ports (Oracle security list + iptables): 8889/tcp WHIP+WHEP https, 8888/tcp LL-HLS https, 8443/tcp API https (auth),
# 8189/udp+tcp WebRTC media, 8890/udp SRT. ckbond keeps :443. TLS: Let's Encrypt relay.ples-duse.org (certbot, port 80 only while renewing).
logLevel: info
logDestinations: [stdout]
readTimeout: 10s
writeTimeout: 10s
writeQueueSize: 1024
udpMaxPayloadSize: 1452

authMethod: internal
authInternalUsers:
  # anyone may watch and read the recordings index; nobody anonymous may publish
  - user: any
    pass:
    ips: []
    permissions:
      - action: read
        path: santoshi
  # the cameras (and the site's admin status call). 15.11.2026 "mixer only" (Marko: "Yes, mixer only"): a camera publishes ONLY on its
  # private path cam-<id> (given by the site's /api/live), never on santoshi; the CLOUD MIXER reads it and is the only publisher there
  - user: santoshi
    pass: "@PUBLISH_HASH@"
    ips: []
    permissions:
      - action: publish
        path: ~^cam-[a-z0-9]{4,16}$
      - action: read
        path: ~^cam-[a-z0-9]{4,16}$
      - action: read
        path: santoshi
      # 15.11.2026 CLOUD MIXER: the camera may publish on pixel (the morning's hand-set KV relay:campath), unchanged
      - action: publish
        path: pixel
      - action: read
        path: pixel
      - action: api
  # the CLOUD MIXER on this machine: the only publisher on santoshi (key /etc/santoshi-relay/mixer-key, only its sha256 here).
  # A user of its own, not "any from 127.0.0.1": the HLS tunnel (cloudflared) also reaches MediaMTX from 127.0.0.1
  - user: mixer
    pass: "@MIXER_HASH@"
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: publish
        path: santoshi
      - action: read
        path: santoshi
  # this machine itself (the uploader's status, tests, the mixer reading the cameras)
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: api
      - action: metrics
      - action: read
        path: pixel
      - action: read
        path: ~^cam-[a-z0-9]{4,16}$

api: true
apiAddress: :8443
apiEncryption: true
apiServerKey: /etc/mediamtx/tls/privkey.pem
apiServerCert: /etc/mediamtx/tls/fullchain.pem
apiAllowOrigins: ["https://santoshi-band.pages.dev"]

metrics: true
metricsAddress: 127.0.0.1:9998
pprof: false
playback: false

rtsp: false
rtmp: false
moq: false

hls: true
hlsAddress: :8888
hlsEncryption: true
hlsServerKey: /etc/mediamtx/tls/privkey.pem
hlsServerCert: /etc/mediamtx/tls/fullchain.pem
hlsAllowOrigins: ["*"]
hlsAlwaysRemux: true
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsMuxerCloseAfter: 60s

webrtc: true
webrtcAddress: :8889
webrtcEncryption: true
webrtcServerKey: /etc/mediamtx/tls/privkey.pem
webrtcServerCert: /etc/mediamtx/tls/fullchain.pem
webrtcAllowOrigins: ["*"]
webrtcLocalUDPAddress: 10.0.0.86:8189
webrtcLocalTCPAddress: 10.0.0.86:8189
# the public IP for everyone; the private and Tailscale addresses too, for a phone whose traffic leaves through this VM (Tailscale exit
# node / the Frankfurt bond): Oracle does not loop a packet from the VM back to its own public IP (15.11.2026, the Pixel's ICE timed out)
# Only the public address, and the media listeners only on the Oracle interface (10.0.0.86, NATed 1:1 to 130.61.181.83): with
# Tailscale in the candidates the Pixel and the Mac (both on Tailscale) chose Tailscale paths that dropped every 5-30 s (15.11.2026)
webrtcIPsFromInterfaces: false
webrtcAdditionalHosts: ["130.61.181.83"]
webrtcICEServers2: []
webrtcHandshakeTimeout: 15s
# a phone's H.264 can come a few seconds after its Opus on a fresh connection: wait for both, or the path is audio only
webrtcTrackGatherTimeout: 8s

srt: true
srtAddress: :8890

pathDefaults:
  record: false

paths:
  # 15.11.2026 "mixer only": every paired camera's private path (cam-<first 10 hex of its token hash>), read by the CLOUD MIXER
  "~^cam-[a-z0-9]{4,16}$":
    source: publisher
    overridePublisher: true
    record: false
  # 15.11.2026 CLOUD MIXER: a camera input for the mixer on this VM (only the camera user and 127.0.0.1 read it)
  pixel:
    source: publisher
    overridePublisher: true
    record: false
  santoshi:
    source: publisher
    # only the mixer publishes here (user mixer); its own reconnect replaces its stale session
    overridePublisher: true
    # every stream is kept on the VM's disk in 1 min pieces; santoshi-rec-upload puts them on Drive; the disk keeps 7 days (Drive uploads can lag: rclone shares a Google quota)
    record: true
    recordPath: /srv/santoshi-rec/%path/%Y-%m-%d_%H-%M-%S-%f
    recordFormat: fmp4
    recordPartDuration: 1s
    recordSegmentDuration: 1m
    recordDeleteAfter: 168h
    # LATER, OFF (Marko, 14.11.2026: "without YouTube branding"): a forward to YouTube or any RTMP server. To switch it on, put the
    # stream key into /etc/mediamtx/forward.env as FORWARD_URL=rtmp://a.rtmp.youtube.com/live2/<key> and uncomment the two lines:
    # runOnReady: /usr/local/lib/chromium-vm/santoshi-forward
    # runOnReadyRestart: yes
