[Unit]
Description=chromium-vm: Santoshi relay (MediaMTX): one stream in by WHIP/SRT, every viewer out by WHEP/LL-HLS, recorded
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediamtx
Group=mediamtx
UMask=0002
ExecStart=/opt/mediamtx/current/mediamtx /etc/mediamtx/mediamtx.yml
Restart=always
RestartSec=3
# below Connection Keeper (README "Priority: Connection Keeper first")
Slice=vmsvc.slice
MemoryMax=1500M
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/santoshi-rec
WorkingDirectory=/srv/santoshi-rec

[Install]
WantedBy=multi-user.target
