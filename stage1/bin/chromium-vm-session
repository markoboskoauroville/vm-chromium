#!/bin/bash
# chromium-vm's desktop: the window manager (openbox) and the compositor, nothing else (14.11.2026, Marko: "only thing
# which is running is connection keeper ... all other services are optional"). Chrome is its own service since then
# (chromium-vm-chrome, started by hand or by vmctl); Claude Code, the Claude app and the dock are services too (desktop/).
set -uo pipefail
. /etc/chromium-vm.conf
export DISPLAY=":${DISPLAY_NUM}"
uid=$(id -u)
if [ -d "/run/user/$uid" ]; then
  export XDG_RUNTIME_DIR="/run/user/$uid"
  [ -S "$XDG_RUNTIME_DIR/bus" ] && export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

EXTRA=()
case "$CHROMIUM_SOURCE" in
  # Chrome 136+ refuses DevTools on the default profile folder, so the profile lives in its own folder.
  chrome) CHROMIUM=/usr/bin/google-chrome-stable; PROFILE="$HOME/.config/chromium-vm-chrome"
          EXTRA=(--user-data-dir="$PROFILE" --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222
                 --remote-allow-origins=http://127.0.0.1
                 # Dark everywhere (Marko, 2.11.2026): the UI and prefers-color-scheme dark, and pages without a
                 # dark design darkened by Chrome itself.
                 --force-dark-mode --enable-features=WebContentsForceDark) ;;
  snap) CHROMIUM=/snap/bin/chromium; PROFILE="$HOME/snap/chromium/common/chromium" ;;
  *)    CHROMIUM=/usr/bin/chromium;  PROFILE="$HOME/.config/chromium" ;;
esac

# Wait for the X server.
for _ in $(seq 100); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.2; done
xdpyinfo >/dev/null 2>&1 || { echo "display $DISPLAY not up" >&2; exit 1; }

xsetroot -solid '#202124' 2>/dev/null || true
xset s off -dpms 2>/dev/null || true

# xcompmgr: a compositor, so the status bar can be see-through (alpha) without black holes (2.11.2026).
pgrep -u "$(id -u)" -x xcompmgr >/dev/null || (xcompmgr -n >/dev/null 2>&1 &)

# The window manager. openbox since 2.11.2026 (Marko: windows side by side, Rectangle's keys, every window opens
# maximized, no title bars, the bottom 22 px left to the status bar): desktop/config/openbox-rc.xml. It binds no
# Alt+Tab; the dock binds the only switching key, Command-Tab = Super+Tab. Maximized windows follow a new screen
# size (Mac window, phone portrait) by themselves. matchbox stays the fallback (one window fills the screen).
OBRC=/usr/local/lib/chromium-vm/openbox-rc.xml
if command -v openbox >/dev/null && [ -f "$OBRC" ]; then
  openbox --config-file "$OBRC" &
  wm=$!
  watcher=""
else
  KBD=/usr/local/lib/chromium-vm/matchbox-kbdconfig
  KBDARGS=(); [ -f "$KBD" ] && KBDARGS=(-kbdconfig "$KBD")
  matchbox-window-manager -use_titlebar no -use_cursor yes "${KBDARGS[@]}" &
  wm=$!
  # Keep the three screens filling the screen when the client changes the size (matchbox does not).
  (
    last=""
    while sleep 1; do
      size=$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2}')
      [ -n "$size" ] || continue
      if [ "$size" != "$last" ]; then
        last=$size
        w=${size%x*}; h=${size#*x}
        for id in $(xdotool search --onlyvisible --class '^(google-chrome|Google-chrome|chromium|Chromium|Xfce4-terminal|com\.anthropic\.Claude)$' 2>/dev/null); do
          xdotool windowmove "$id" 0 0 windowsize "$id" "$w" "$h" 2>/dev/null || true
        done
      fi
    done
  ) &
  watcher=$!
fi
trap 'kill $wm $watcher 2>/dev/null' EXIT

# Chrome no longer lives here (14.11.2026): stage1/bin/chromium-vm-chrome, service chromium-vm-chrome (vmctl start chrome).
wait $wm
