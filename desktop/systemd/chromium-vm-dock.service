[Unit]
Description=chromium-vm: the dock (three live screens at the bottom edge) and Command-Tab (Super+Tab)
After=chromium-vm-session.service
BindsTo=chromium-vm-xvnc.service

[Service]
Type=simple
User=@VM_USER@
Environment=DISPLAY=:1
ExecStart=/usr/bin/python3 /usr/local/lib/chromium-vm/chromium-vm-dock.py
Restart=always
RestartSec=3

[Install]
WantedBy=chromium-vm-xvnc.service
