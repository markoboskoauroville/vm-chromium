[Unit]
Description=chromium-vm: the Pixel 7 bar (PORTRAIT | LANDSCAPE, REBOOT) over screen 4
After=chromium-vm-session.service docker.service
BindsTo=chromium-vm-xvnc.service

[Service]
Type=simple
User=@VM_USER@
Environment=DISPLAY=:1
ExecStart=/usr/bin/python3 /usr/local/lib/chromium-vm/chromium-vm-pixel7-bar.py
Restart=always
RestartSec=3

[Install]
WantedBy=chromium-vm-xvnc.service
