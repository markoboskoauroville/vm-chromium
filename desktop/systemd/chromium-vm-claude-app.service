[Unit]
Description=chromium-vm: screen 2, the Claude application (official Claude Desktop for Linux)
After=chromium-vm-session.service
BindsTo=chromium-vm-xvnc.service

[Service]
Type=simple
User=@VM_USER@
ExecStart=/usr/local/lib/chromium-vm/chromium-vm-claude-app
Restart=always
RestartSec=3

[Install]
WantedBy=chromium-vm-xvnc.service
