[Unit]
Description=chromium-vm: screen 1, Claude Code in a terminal (tmux session "claude")
After=chromium-vm-session.service
BindsTo=chromium-vm-xvnc.service

[Service]
Type=simple
User=@VM_USER@
ExecStart=/usr/local/lib/chromium-vm/chromium-vm-claude-code
Restart=always
RestartSec=3

[Install]
WantedBy=chromium-vm-xvnc.service
