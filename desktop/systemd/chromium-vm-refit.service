[Unit]
Description=chromium-vm: snapped windows follow a new screen size (the Mac window resized or maximized, Marko 5.11.2026)
After=chromium-vm-session.service
BindsTo=chromium-vm-xvnc.service

[Service]
Type=simple
User=@VM_USER@
Environment=DISPLAY=:1
ExecStart=/usr/bin/python3 /usr/local/lib/chromium-vm/chromium-vm-snap watch
Restart=always
RestartSec=3

[Install]
WantedBy=chromium-vm-xvnc.service
