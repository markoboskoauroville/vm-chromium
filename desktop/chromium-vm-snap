#!/usr/bin/env python3
"""chromium-vm-snap ACTION: Rectangle on the VM (Marko, 2.11.2026: "Rectangle-style keyboard shortcuts").
Called by openbox's keybindings (Ctrl+Alt+key = ⌃⌥key from the Mac viewer). Snaps the active window inside the
work area (screen less the status bar), like Rectangle's defaults:
left right top bottom | max center | tl tr bl br | third1 third2 third3 | two1 two2 | restore
`show code|claude|chrome|pixel|pixel2|firefox` one program alone and full, started first when it has no window (5.11.2026)
`layout code-chrome|claude-chrome|claude-pixels|code-pixels` arranges all three programs at once (the dock's layout displays, Marko 2.11.2026):
halves = Claude Code left | Chrome right; cc-halves = Claude | Chrome; cc-40-60 = Claude 40% | Chrome 60%; big = Chrome on the first two
thirds, Claude Code top right, Claude bottom right.
The geometry before the first snap is kept in ~/.cache/chromium-vm/snap.json, so `restore` brings it back."""
import json, os, subprocess, sys, time

STATE = os.path.expanduser('~/.cache/chromium-vm/snap.json')
# v2 (Marko, 5.11.2026: the viewer maximized, the VM's screen grew, but the triple view stayed in the old corner): the slot
# each window was last snapped into, so `refit` (run by `watch` on every new screen size) puts it into the same slot again
SLOTS = os.path.expanduser('~/.cache/chromium-vm/slots.json')
BAR = 22
# 7.11.2026 (Marko: "Window should fit exactly the screen of the Pixel ... zero gray bars"): a phone window has the
# phone's own shape (1080x2400 portrait, both containers) at the full height; whatever width is left goes to the program
# beside it. Slots before2 (the rest, on the left), phone1, phone2 (side by side at the right), phonec (one phone alone,
# centred). Marko, 7.11.2026: "First stripe is Claude, then two stripes of androids."
PHONE_W, PHONE_H = 1080, 2400

def sh(*a):
    return subprocess.run(a, capture_output=True, text=True, timeout=3).stdout

APPS = {'code': lambda i, c, t: c == 'Xfce4-terminal', 'claude': lambda i, c, t: c.lower() == 'com.anthropic.claude',
        'chrome': lambda i, c, t: c == 'Google-chrome' and 'chromium-vm-chrome' in i,
        # 7.11.2026: two phones, both scrcpy windows, told apart by their titles (chromium-vm-pixel7 1 | 2)
        'pixel': lambda i, c, t: c.lower() == 'scrcpy' and t != 'Pixel 2',
        'pixel2': lambda i, c, t: c.lower() == 'scrcpy' and t == 'Pixel 2',
        # 14.11.2026 (Marko: "give it its own window down there ... I need to have Firefox only view"): Firefox, own
        # profile ~/.config/vm-firefox, WM_CLASS VMFirefox
        'firefox': lambda i, c, t: c == 'VMFirefox'}
# Marko, 5.11.2026: "Combinations: 40 60 ... you don't need to make any other combinations": four layouts only,
# Claude Code or Claude on the 40 side (left), Chrome or the Pixel 7 on the 60 side (right)
LAYOUTS = {'code-chrome': [('code', 'l40'), ('chrome', 'r60')],
           'claude-chrome': [('claude', 'l40'), ('chrome', 'r60')],
           # Marko, 5.11.2026: "only the triple view with Pixel 7 ... Claude application, Claude code, our phone", ⅓ each
           # 7.11.2026 (Marko): replaced by the Claude app and the two phones: "First stripe is Claude, then two stripes of androids"
           'claude-pixels': [('claude', 'before2'), ('pixel', 'phone1'), ('pixel2', 'phone2')],
           'code-pixels': [('code', 'before2'), ('pixel', 'phone1'), ('pixel2', 'phone2')]}   # Marko 7.11.2026: the copy with Claude Code

# 5.11.2026 (Marko: "If an app is not running, when I switch to the window, it needs to run the app to fill up the
# window. This bottom part is at the same time a launcher and a window manager"): how each program is started when it
# has no window. Claude Code and the Pixel 7 are services that restart themselves after 3 s; `start` only hurries
# them. Chrome's own loop (chromium-vm-session) brings it back after 1 s, but a running Chrome with no window gets one.
# Claude Desktop can keep running with no window (closed to the tray): claude-desktop shows it again.
CHROME_PROFILE = os.path.expanduser('~/.config/chromium-vm-chrome')
LAUNCH = {
    'code': ['sudo', '-n', 'systemctl', 'start', 'chromium-vm-claude-code'],
    'claude': ['claude-desktop'],
    'chrome': ['google-chrome-stable', f'--user-data-dir={CHROME_PROFILE}', '--new-window'],
    # 9.11.2026: the phones are on demand (the reaper stops idle ones): the phone tool starts the container, waits for
    # Android and starts the scrcpy screen
    'pixel': ['/usr/local/lib/chromium-vm/chromium-vm-phone', 'start', '1', '--mirror'],
    'pixel2': ['/usr/local/lib/chromium-vm/chromium-vm-phone', 'start', '2', '--mirror'],
    # 14.11.2026: Firefox is the WhatsApp machine: remote control on 9223, home page WhatsApp (vm-whatsapp)
    'firefox': ['/usr/local/lib/chromium-vm/vm-whatsapp', 'start'],
}

def launch(name):
    if name == 'chrome' and subprocess.run(['pgrep', '-f', f'user-data-dir={CHROME_PROFILE}'], capture_output=True).returncode:
        return                                   # no Chrome at all: the session's loop is starting it
    if name == 'code' and subprocess.run(['systemctl', 'is-active', '--quiet', 'chromium-vm-claude-code']).returncode == 0:
        subprocess.run(['sudo', '-n', 'systemctl', 'restart', 'chromium-vm-claude-code'], capture_output=True)
        return                                   # active but no window (a terminal closed by hand): a fresh one
    unit = {'pixel': 'chromium-vm-pixel7', 'pixel2': 'chromium-vm-pixel7b'}.get(name)
    if unit and subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode == 0:
        subprocess.run(['sudo', '-n', 'systemctl', 'restart', unit], capture_output=True)
        return
    # 9.11.2026: not active = the reaper stopped it (or never started): the phone tool brings the container up first
    subprocess.Popen(LAUNCH[name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def ensure(names, wait=40):
    """Every program named has a window: the missing ones are started, then waited for (at most `wait` s)."""
    wins = app_windows(True)
    missing = [n for n in names if n not in wins]
    for n in missing:
        launch(n)
    t0 = time.time()
    while missing and time.time() - t0 < wait:
        time.sleep(0.5)
        wins = app_windows(True)
        missing = [n for n in missing if n not in wins]
    if missing: return app_windows(True)
    time.sleep(0.6 if len(names) else 0)          # a new window settles (its first maximize) before it is placed
    return app_windows(True)

def app_windows(iconic=False):
    """The topmost normal, mapped window of each program (by WM_CLASS, from openbox's stacking list); iconic=True
    counts minimized ones too (they come back with windowactivate)."""
    out = {}
    try:
        stack = sh('xprop', '-root', '_NET_CLIENT_LIST_STACKING').split('#', 1)[1].replace(',', ' ').split()
    except Exception:
        return out
    for wid in stack:
        p = sh('xprop', '-id', wid, 'WM_CLASS', '_NET_WM_WINDOW_TYPE', 'WM_STATE', '_NET_WM_NAME')
        if ('Iconic' in p and not iconic) or ('_NET_WM_WINDOW_TYPE_NORMAL' not in p and '_NET_WM_WINDOW_TYPE(' in p): continue
        try: inst, cls = [x.strip().strip('"') for x in p.split('WM_CLASS(STRING) = ')[1].splitlines()[0].split('", "')]
        except Exception: continue
        title = p.split('_NET_WM_NAME(UTF8_STRING) = ', 1)[1].splitlines()[0].strip().strip('"') if '_NET_WM_NAME(UTF8_STRING) = ' in p else ''
        for name, test in APPS.items():
            if test(inst, cls, title): out[name] = str(int(wid, 16))
    return out

def slots(update=None):
    try: sl = json.load(open(SLOTS))
    except Exception: sl = {}
    if update:
        for k, v in update.items():
            if v is None: sl.pop(k, None)
            else: sl[k] = v
        os.makedirs(os.path.dirname(SLOTS), exist_ok=True); json.dump(sl, open(SLOTS, 'w'))
    return sl

def screen_size():
    try: return sh('xdotool', 'getdisplaygeometry').strip()
    except Exception: return ''

def refit():
    """every window still alive goes back into its slot at the new screen size (maximized ones follow by themselves)"""
    alive = set(str(int(w, 16)) for w in sh('xprop', '-root', '_NET_CLIENT_LIST').split('#', 1)[-1].replace(',', ' ').split()
                if w.startswith('0x'))
    sl = slots()
    gone = {w: None for w in sl if w not in alive}
    if gone: sl = slots(gone)
    for wid, act in sl.items():
        place(wid, act, remember=False)

def watch():
    last = screen_size()
    while True:
        time.sleep(0.5)
        size = screen_size()
        if size and size != last:
            last = size
            time.sleep(0.4)          # openbox settles its work area first
            try: refit()
            except Exception as e: print('refit:', e, flush=True)

def main():
    act = sys.argv[1] if len(sys.argv) > 1 else ''
    if act == 'watch': return watch()
    if act == 'refit': return refit()
    if act == 'show':                            # one program, alone and full: started first if it has no window
        name = sys.argv[2] if len(sys.argv) > 2 else ''
        wid = ensure([name]).get(name)
        if wid and name in ('pixel', 'pixel2'):      # a phone alone: its own shape, centred, not stretched to bars
            sh('xdotool', 'windowactivate', wid); place(wid, 'phonec')
        elif wid:
            sh('xdotool', 'windowactivate', wid)
            sh('wmctrl', '-i', '-r', wid, '-b', 'add,maximized_vert,maximized_horz')
            slots({wid: None})
        return
    if act == 'layout':
        plan = LAYOUTS.get(sys.argv[2] if len(sys.argv) > 2 else '', [])
        wins = ensure([n for n, _ in plan])      # a program closed by accident comes back into its place
        for name, rect in plan:
            if name in wins: place(wins[name], rect)
        for name, _ in plan:
            if name in wins: sh('xdotool', 'windowactivate', wins[name])
        return
    wid = sh('xdotool', 'getactivewindow').strip()
    if wid: place(wid, act)

def place(wid, act, remember=True):
    W, H = map(int, sh('xdotool', 'getdisplaygeometry').split())
    try:   # openbox puts its margins into _NET_WORKAREA
        wa = [int(v) for v in sh('xprop', '-root', '_NET_WORKAREA').split('=')[1].replace(',', ' ').split()[:4]]
        X0, Y0, AW, AH = wa
    except Exception:
        X0, Y0, AW, AH = 0, 0, W, H - BAR
    g = {}
    for line in sh('xdotool', 'getwindowgeometry', '--shell', wid).splitlines():
        k, _, v = line.partition('='); g[k] = int(v) if v.lstrip('-').isdigit() else v
    cur = [g.get('X', 0), g.get('Y', 0), g.get('WIDTH', AW), g.get('HEIGHT', AH)]
    try: st = json.load(open(STATE))
    except Exception: st = {}
    h2, w2, w3 = AH // 2, AW // 2, AW // 3
    R = {'left': (0, 0, w2, AH), 'right': (AW - w2, 0, w2, AH), 'top': (0, 0, AW, h2), 'bottom': (0, AH - h2, AW, h2),
         'max': (0, 0, AW, AH), 'tl': (0, 0, w2, h2), 'tr': (AW - w2, 0, w2, h2), 'bl': (0, AH - h2, w2, h2),
         'br': (AW - w2, AH - h2, w2, h2), 'third1': (0, 0, w3, AH), 'third2': (w3, 0, w3, AH),
         'third3': (AW - w3, 0, w3, AH), 'two1': (0, 0, AW - w3, AH), 'two2': (w3, 0, AW - w3, AH),
         'r3top': (AW - w3, 0, w3, h2), 'r3bot': (AW - w3, AH - h2, w3, h2),
         'l40': (0, 0, max(600, AW * 2 // 5), AH), 'r60': (max(600, AW * 2 // 5), 0, AW - max(600, AW * 2 // 5), AH)}
    pw = round(AH * PHONE_W / PHONE_H)              # a phone at the full height, exactly its shape: no bars
    R.update({'before2': (0, 0, AW - 2 * pw, AH), 'phone1': (AW - 2 * pw, 0, pw, AH), 'phone2': (AW - pw, 0, pw, AH),
              'phonec': ((AW - pw) // 2, 0, pw, AH)})
    if remember: slots({wid: act if act in R else None})
    if act == 'restore':
        if wid not in st: return
        x, y, w, h = st.pop(wid); json.dump(st, open(STATE, 'w'))
        sh('wmctrl', '-i', '-r', wid, '-b', 'remove,maximized_vert,maximized_horz')
        sh('wmctrl', '-i', '-r', wid, '-e', f'0,{x},{y},{w},{h}'); return
    if act == 'center':
        w, h = min(cur[2], AW), min(cur[3], AH)
        x, y = X0 + (AW - w) // 2, Y0 + (AH - h) // 2
    elif act in R:
        x, y, w, h = R[act]; x += X0; y += Y0
    else:
        sys.exit(f'unknown action {act!r}')
    if wid not in st:    # the place before the first snap (Rectangle's "restore")
        st[wid] = cur; os.makedirs(os.path.dirname(STATE), exist_ok=True); json.dump(st, open(STATE, 'w'))
    if act == 'max':
        sh('wmctrl', '-i', '-r', wid, '-b', 'add,maximized_vert,maximized_horz'); return
    sh('wmctrl', '-i', '-r', wid, '-b', 'remove,maximized_vert,maximized_horz')
    sh('wmctrl', '-i', '-r', wid, '-e', f'0,{x},{y},{w},{h}')
    # A program with a minimum size (Claude Desktop: 600 px wide) stays bigger than the slot: keep it on the screen.
    import time; time.sleep(0.15)
    g2 = dict(l.partition('=')[::2] for l in sh('xdotool', 'getwindowgeometry', '--shell', wid).splitlines())
    rw, rh = int(g2.get('WIDTH', w)), int(g2.get('HEIGHT', h))
    nx, ny = min(x, X0 + AW - rw), min(y, Y0 + AH - rh)
    if (nx, ny) != (x, y): sh('wmctrl', '-i', '-r', wid, '-e', f'0,{max(X0, nx)},{max(Y0, ny)},-1,-1')

if __name__ == '__main__':
    main()
