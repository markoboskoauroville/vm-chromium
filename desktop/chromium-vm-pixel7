#!/bin/bash
# Screen 4 (Marko, 5.11.2026: "It needs to have now a fourth app ... Pixel 7. Make it always run, and I can switch to
# it"): the Pixel 7 (vm-android, the redroid container pixel7 on this machine, adb 127.0.0.1:5555) live in a window
# through scrcpy, mouse and keyboard go to the phone. Started again whenever it quits (systemd Restart=always).
# scrcpy 5 from /opt/scrcpy (built by GitHub, vm-android release scrcpy-v5.0.1): Ubuntu's 1.25 crashed its input
# thread on Android 14+, the window took no clicks (5.11.2026).
set -uo pipefail
. /etc/chromium-vm.conf
export DISPLAY=":${DISPLAY_NUM}"
for _ in $(seq 100); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.2; done
SERIAL=127.0.0.1:5555
adb connect "$SERIAL" >/dev/null 2>&1
adb -s "$SERIAL" wait-for-device
until [ "$(adb -s "$SERIAL" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; do sleep 2; done
# software decoding on two cores: 30 frames a second, the long side 1600 px; no sound (the VM has no speakers)
exec /opt/scrcpy/bin/scrcpy -s "$SERIAL" --window-title "Pixel 7" --max-fps 30 --max-size 1600 --video-bit-rate 6M \
  --no-audio --shortcut-mod=lalt 2>&1
